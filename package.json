{
  "name": "catat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "bun test src/",
    "test:e2e": "export PATH=\"/opt/homebrew/opt/openjdk@25/bin:$PATH\" && firebase emulators:exec --only auth,firestore \"bun test tests/e2e-gates.test.ts\"",
