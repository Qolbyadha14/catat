rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/system_admins/$(request.auth.uid));
    }

    function isLedgerMember(ledgerId) {
      return isAuthenticated() && (
        ledgerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/ledgers/$(ledgerId)) &&
         request.auth.uid in get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members)
      );
    }

    // System Admins
    match /system_admins/{adminUid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Dynamic System Configuration
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // AI Telemetry & Audit Logs
    match /ai_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isSuperAdmin();
      allow update: if false;
    }

    // Collaborative Family Ledgers
    match /ledgers/{ledgerId} {
      allow read: if isSuperAdmin() || isLedgerMember(ledgerId) || (
        isAuthenticated() && resource != null && resource.data.inviteCode != null
      );
      allow create: if isAuthenticated();
      allow update: if isLedgerMember(ledgerId) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      match /accounts/{accountId} {
        allow read, create: if isLedgerMember(ledgerId);
        allow update: if isLedgerMember(ledgerId) && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read, create: if isLedgerMember(ledgerId);
        allow update: if isLedgerMember(ledgerId) && request.resource.data.type == resource.data.type;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
    }

    match /users/{uid} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      match /accounts/{accountId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.type == resource.data.type;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /scanUsage/{usageId} {
      allow read: if isSuperAdmin() || (
        request.auth != null && (
          usageId.matches('^' + request.auth.uid + '_.*') ||
          (resource != null && resource.data.uid == request.auth.uid)
        )
      );
      allow create: if request.auth != null
        && (usageId.matches('^' + request.auth.uid + '_.*') || request.resource.data.uid == request.auth.uid)
        && request.resource.data.count <= 20
        && request.resource.data.count >= 1;
      allow update: if (request.auth != null
        && (usageId.matches('^' + request.auth.uid + '_.*') || resource.data.uid == request.auth.uid)
        && request.resource.data.count <= 20) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}

