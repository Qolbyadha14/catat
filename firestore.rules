rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/system_admins/$(request.auth.uid));
    }

    function isLedgerMember(ledgerId) {
      return isAuthenticated() && (
        ledgerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/ledgers/$(ledgerId)) &&
         request.auth.uid in get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.members)
      );
    }

    // ---- Validasi bentuk data (cermin dari src/lib/schemas.ts) ----

    // Nominal rupiah: bilangan bulat positif, maksimal 1 triliun
    function isValidAmount(v) {
      return v is int && v > 0 && v <= 1000000000000;
    }

    function isValidTransaction(d, transactionId) {
      return d.id == transactionId
        && d.type in ['income', 'expense', 'transfer']
        && isValidAmount(d.amount)
        && d.date is int
        && d.createdAt is int
        && d.updatedAt is int
        && (d.type == 'transfer'
              ? (d.fromAccountId is string && d.toAccountId is string && d.fromAccountId != d.toAccountId)
              : (d.accountId is string && d.categoryId is string))
        && d.get('note', '') is string
        && d.get('note', '').size() <= 140;
    }

    // Saat membuat: createdBy (bila ada) harus penulisnya sendiri
    function createdByIsAuthor(d) {
      return !('createdBy' in d) || d.createdBy.uid == request.auth.uid;
    }

    // Saat mengedit: atribusi lama boleh dipertahankan, atau diganti menjadi penulis sendiri
    function createdByKeptOrAuthor(d, old) {
      return !('createdBy' in d)
        || ('createdBy' in old && d.createdBy == old.createdBy)
        || d.createdBy.uid == request.auth.uid;
    }

    function canCreateTransaction(transactionId) {
      return isValidTransaction(request.resource.data, transactionId)
        && createdByIsAuthor(request.resource.data);
    }

    function canUpdateTransaction(transactionId) {
      return isValidTransaction(request.resource.data, transactionId)
        && request.resource.data.createdAt == resource.data.createdAt
        && createdByKeptOrAuthor(request.resource.data, resource.data);
    }

    function isValidAccount(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.kind in ['asset', 'liability']
        && d.balance is int;
    }

    function isValidCategory(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 32
        && d.type in ['income', 'expense']
        && (!('monthlyBudget' in d) || d.monthlyBudget == null || (d.monthlyBudget is int && d.monthlyBudget >= 0));
    }

    // System Admins: tiap user hanya bisa memeriksa dokumen miliknya sendiri
    match /system_admins/{adminUid} {
      allow get: if isAuthenticated() && request.auth.uid == adminUid;
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // Dynamic System Configuration
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // AI Telemetry & Audit Logs
    match /ai_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isSuperAdmin();
      allow update: if false;
    }

    // Collaborative Family Ledgers
    match /ledgers/{ledgerId} {
      function isLedgerOwner() {
        return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function onlyOwnMemberEntryChanged() {
        return changedKeys().hasOnly(['members', 'updatedAt'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
      }
      function ownEntryAfter() {
        return request.resource.data.members[request.auth.uid];
      }

      allow read: if isSuperAdmin() || isLedgerMember(ledgerId);

      // ID ledger harus sama dengan UID pembuat agar ledger orang lain tidak bisa "diduduki" lebih dulu
      allow create: if isAuthenticated()
        && ledgerId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      allow update: if
        // Owner: boleh mengelola anggota, nama, dan kode undangan, tapi tidak boleh memindahkan kepemilikan
        (isLedgerOwner() && !changedKeys().hasAny(['ownerUid']))
        // Anggota: hanya boleh mengubah atau menghapus entry miliknya sendiri, tanpa menaikkan role
        || (isAuthenticated()
            && !isLedgerOwner()
            && request.auth.uid in resource.data.members
            && onlyOwnMemberEntryChanged()
            && (!(request.auth.uid in request.resource.data.members) || ownEntryAfter().role == 'member'))
        // Calon anggota: hanya boleh menambahkan dirinya sendiri dengan kode undangan yang benar
        || (isAuthenticated()
            && !(request.auth.uid in resource.data.members)
            && onlyOwnMemberEntryChanged()
            && ownEntryAfter().uid == request.auth.uid
            && ownEntryAfter().role == 'member'
            && ownEntryAfter().joinCode == resource.data.inviteCode);

      allow delete: if isLedgerOwner();

      match /accounts/{accountId} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if isLedgerMember(ledgerId) && isValidAccount(request.resource.data);
        allow update: if isLedgerMember(ledgerId) && isValidAccount(request.resource.data)
          && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if isLedgerMember(ledgerId) && isValidCategory(request.resource.data);
        allow update: if isLedgerMember(ledgerId) && isValidCategory(request.resource.data)
          && request.resource.data.type == resource.data.type;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, delete: if isLedgerMember(ledgerId);
        allow create: if isLedgerMember(ledgerId) && canCreateTransaction(transactionId);
        allow update: if isLedgerMember(ledgerId) && canUpdateTransaction(transactionId);
      }
    }

    // Indeks kode undangan -> ledgerId. Hanya bisa diambil per kode, tidak bisa di-list.
    match /invites/{code} {
      function ledgerAfter(id) {
        return getAfter(/databases/$(database)/documents/ledgers/$(id)).data;
      }

      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['ledgerId', 'createdAt'])
        && ledgerAfter(request.resource.data.ledgerId).ownerUid == request.auth.uid
        && ledgerAfter(request.resource.data.ledgerId).inviteCode == code;
      allow update: if false;
      allow delete: if isAuthenticated()
        && get(/databases/$(database)/documents/ledgers/$(resource.data.ledgerId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      match /accounts/{accountId} {
        allow read: if isOwner();
        allow create: if isOwner() && isValidAccount(request.resource.data);
        allow update: if isOwner() && isValidAccount(request.resource.data)
          && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if isOwner();
        allow create: if isOwner() && isValidCategory(request.resource.data);
        allow update: if isOwner() && isValidCategory(request.resource.data)
          && request.resource.data.type == resource.data.type;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && canCreateTransaction(transactionId);
        allow update: if isOwner() && canUpdateTransaction(transactionId);
      }
    }

    match /scanUsage/{usageId} {
      function ownsUsage() {
        return isAuthenticated()
          && usageId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function dailyOcrLimit() {
        return exists(/databases/$(database)/documents/system_config/global)
          ? get(/databases/$(database)/documents/system_config/global).data.get('dailyOcrLimit', 20)
          : 20;
      }

      allow read: if isSuperAdmin() || ownsUsage();
      allow create: if ownsUsage()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if ownsUsage()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= dailyOcrLimit();
      // Reset kuota hanya lewat admin (UsersLedgersTab memakai deleteDoc)
      allow delete: if isSuperAdmin();
    }
  }
}

