rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /accounts/{accountId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.type == resource.data.type;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /scanUsage/{usageId} {
      allow read: if request.auth != null && (
        usageId.matches('^' + request.auth.uid + '_.*') ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null
        && (usageId.matches('^' + request.auth.uid + '_.*') || request.resource.data.uid == request.auth.uid)
        && request.resource.data.count <= 20
        && request.resource.data.count >= 1;
      allow update: if request.auth != null
        && (usageId.matches('^' + request.auth.uid + '_.*') || resource.data.uid == request.auth.uid)
        && request.resource.data.count <= 20;
      allow delete: if false;
    }
  }
}
